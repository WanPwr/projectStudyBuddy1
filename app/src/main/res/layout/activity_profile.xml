<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btnProfileBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/text_dark"
        android:contentDescription="Go Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivProfileAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_profile2"
        app:tint="@color/text_dark"
        android:contentDescription="Profile Avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvProfileUserLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="USERNAME"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/ivProfileAvatar"
        app:layout_constraintStart_toStartOf="@id/etProfileUsername"
        tools:ignore="HardcodedText" />

    <EditText
        android:id="@+id/etProfileUsername"
        android:layout_width="360dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:inputType="textPersonName"
        android:textColor="@color/text_dark"
        android:text="abu"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/tvProfileUserLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvProfilePassLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PASSWORD"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/etProfileUsername"
        app:layout_constraintStart_toStartOf="@id/etProfilePassword"
        tools:ignore="HardcodedText" />

    <EditText
        android:id="@+id/etProfilePassword"
        android:layout_width="360dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:inputType="textPassword"
        android:textColor="@color/text_dark"
        android:text="......"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/tvProfilePassLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnProfileSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="SAVE"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/accent_brown"
        app:layout_constraintTop_toBottomOf="@id/etProfilePassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/btnProfileLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="LOG OUT"
        android:textColor="@color/accent_brown"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnProfileSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>