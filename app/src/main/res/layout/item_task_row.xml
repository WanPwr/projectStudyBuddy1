<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:drawable/editbox_background"
        android:padding="16dp"
        tools:ignore="UnusedAttribute">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTaskRowDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26/06/26 12:04"
                android:textSize="11sp"
                android:textColor="@color/text_hint_darker"
                android:layout_marginBottom="4dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvTaskRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Title Placeholder"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#3D405B"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:id="@+id/pbRowTaskMeter"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@android:drawable/progress_horizontal"
                    android:progressTint="@color/accent_orange"
                    android:progressBackgroundTint="#E0E0E0"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/tvRowTaskPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_orange"
                    android:layout_marginStart="8dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivTaskRowDelete"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Delete"
            app:tint="#D97A53"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</androidx.cardview.widget.CardView>