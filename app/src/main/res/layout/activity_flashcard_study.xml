<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/btnFlashcardBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/accent_brown"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@string/desc_go_back" />

    <TextView
        android:id="@+id/tvDeckNameHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="@string/deck_study_workspace"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnFlashcardBack"
        app:layout_constraintBottom_toBottomOf="@id/btnFlashcardBack"
        app:layout_constraintStart_toEndOf="@id/btnFlashcardBack"
        app:layout_constraintEnd_toStartOf="@id/btnEditFlashcard" />

    <EditText
        android:id="@+id/etDeckNameEdit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:hint="Deck Title"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@android:drawable/edit_text"
        android:padding="6dp"
        android:inputType="text"
        android:visibility="gone"
        android:importantForAutofill="no"
        app:layout_constraintTop_toTopOf="@id/btnFlashcardBack"
        app:layout_constraintBottom_toBottomOf="@id/btnFlashcardBack"
        app:layout_constraintStart_toEndOf="@id/btnFlashcardBack"
        app:layout_constraintEnd_toStartOf="@id/btnEditFlashcard"
        tools:ignore="HardcodedText"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnEditFlashcard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="@color/accent_brown"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/desc_toggle_edit" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvFlashcardSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnFlashcardBack"
        app:layout_constraintBottom_toTopOf="@id/llNavigationControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvCardIndexBadge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_badge"
                android:gravity="center"
                android:text="@string/default_card_index"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvFlashcardDisplayContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/tap_to_reveal_answer"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@id/tvCardIndexBadge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/llEditorWorkspacePanel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvCardIndexBadge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <EditText
                    android:id="@+id/etEditQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_type_question"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/bg_cream" />

                <EditText
                    android:id="@+id/etEditAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_type_answer"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDeleteFlashcard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#E07A5F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="@string/desc_delete_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/llNavigationControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPreviousCard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/accent_brown"
            android:contentDescription="@string/desc_previous_card" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddNewFlashcard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_add"
            android:backgroundTint="@color/accent_brown"
            app:tint="@android:color/white"
            app:fabSize="mini"
            android:contentDescription="@string/desc_add_new_card" />

        <ImageButton
            android:id="@+id/btnNextCard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/accent_brown"
            android:contentDescription="@string/desc_next_card" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>