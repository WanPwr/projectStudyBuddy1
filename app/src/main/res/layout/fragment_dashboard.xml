<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivDashboardAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_profile2"
            app:tint="@color/text_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="Avatar" />

        <TextView
            android:id="@+id/tvWelcomeUserHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="WELCOME BACK,"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-condensed"
            app:layout_constraintTop_toBottomOf="@id/ivDashboardAvatar"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/layoutStreakTrackerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="#EAE3D2"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeUserHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView android:id="@+id/tvStreakDay1" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="1"/>
            <TextView android:id="@+id/tvStreakDay2" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="2"/>
            <TextView android:id="@+id/tvStreakDay3" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="3"/>
            <TextView android:id="@+id/tvStreakDay4" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="4"/>
            <TextView android:id="@+id/tvStreakDay5" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="5"/>
            <TextView android:id="@+id/tvStreakDay6" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="6"/>
            <TextView android:id="@+id/tvStreakDay7" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="4dp" android:background="@drawable/circle_badge" android:textColor="#3D405B" android:textStyle="bold" android:gravity="center" android:text="7"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvReminderSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reminder :"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            app:layout_constraintTop_toBottomOf="@id/layoutStreakTrackerRow"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <View
            android:id="@+id/reminderDividerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/text_dark"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvReminderSectionLabel" />

        <TextView
            android:id="@+id/tvTotalChartHeaderBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/divider_gray"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Total To-Do Completion"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/reminderDividerLine"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/todoPieChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalChartHeaderBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/chartDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_gray"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/todoPieChart" />

        <TextView
            android:id="@+id/tvIndividualListHeaderBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/divider_gray"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Individual To-Do Completion"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/chartDividerLine"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMasterTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvIndividualListHeaderBox"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvEmptyTasksPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="No tasks available"
            android:textColor="@color/text_hint_darker"
            android:textSize="16sp"
            android:textStyle="italic"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvIndividualListHeaderBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>