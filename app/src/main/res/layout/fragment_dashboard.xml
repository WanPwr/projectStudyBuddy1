<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivDashboardAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="@color/text_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="Avatar"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvWelcomeUserHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="WELCOME BACK, user"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-condensed"
            app:layout_constraintTop_toBottomOf="@id/ivDashboardAvatar"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/layoutDashboardStreakContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/divider_gray"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeUserHeader">

            <TextView
                android:id="@+id/tvStreakCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Streak Running: Day 4"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReminderSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reminder :"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            app:layout_constraintTop_toBottomOf="@id/layoutDashboardStreakContainer"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <View
            android:id="@+id/reminderDividerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/text_dark"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvReminderSectionLabel" />

        <TextView
            android:id="@+id/tvTotalChartHeaderBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/divider_gray"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Total To-Do Completion"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/reminderDividerLine"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/todoPieChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTotalChartHeaderBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/chartDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_gray"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/todoPieChart" />

        <TextView
            android:id="@+id/tvIndividualListHeaderBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/divider_gray"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Individual To-Do Completion"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/chartDividerLine"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMasterTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvIndividualListHeaderBox"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>