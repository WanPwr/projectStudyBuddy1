<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelTaskListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvWelcomeUserHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELCOME BACK, user"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/text_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutStreakTrackerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#EAEAEA"
            android:padding="10dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeUserHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvStreakCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Current Streak: 1 Day"
                android:textStyle="bold"
                android:textColor="#3D405B"
                android:textSize="14sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardProgressMeter"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/layoutStreakTrackerBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TO-DO COMPLETION"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/todoPieChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTaskHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My To-Do Lists"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/cardProgressMeter"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMasterTasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTaskHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCreateList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Create"
            android:backgroundTint="@color/accent_brown"
            app:tint="@android:color/white"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardKeepEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/etNoteMainTitle"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:hint="Title"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_dark"
                    android:background="@android:color/transparent"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"/>
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNestedChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:id="@+id/layoutAddListItemTrigger"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_input_add"
                    android:contentDescription="Add item"
                    app:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="List item"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="24dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/tvEditedTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edited Just Now"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="11sp"/>
                <Button
                    android:id="@+id/btnKeepCloseAndSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Close"
                    android:layout_alignParentEnd="true"
                    style="@style/Widget.AppCompat.Button.Borderless"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>