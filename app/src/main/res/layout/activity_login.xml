<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivLogoIcon"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/image3"
        android:contentDescription="App Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/panelLogin"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/ivLogoIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USERNAME"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etLoginUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:inputType="textPersonName"
            android:textColor="@color/text_dark"
            android:hint="Enter your username"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PASSWORD"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:inputType="textPassword"
            android:textColor="@color/text_dark"
            android:hint="Enter your password"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnLoginSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="LOG IN"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accent_brown"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/btnSwitchToSignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="SIGN UP?\nNO ACCOUNT?"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelSignup"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ivLogoIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE USERNAME"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etSignupUsername"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:inputType="textPersonName"
            android:textColor="@color/text_dark"
            android:hint="Create username"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CREATE PASSWORD"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etSignupPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:inputType="textPassword"
            android:textColor="@color/text_dark"
            android:hint="Create password"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CONFIRM PASSWORD"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_dark"
            tools:ignore="HardcodedText" />

        <EditText
            android:id="@+id/etSignupConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:inputType="textPassword"
            android:textColor="@color/text_dark"
            android:hint="Confirm password"
            android:importantForAutofill="no"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnSignupSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="REGISTER"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accent_brown"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/btnSwitchToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="ALREADY HAVE AN ACCOUNT?\nLOG IN HERE"
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>