<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:padding="20dp">

    <ImageButton
        android:id="@+id/btnJournalEditorBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/accent_brown"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Go Back" />


    <LinearLayout
        android:id="@+id/layoutJournalColorPicker"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnJournalEditorBack"
        app:layout_constraintStart_toEndOf="@id/btnJournalEditorBack"
        app:layout_constraintEnd_toStartOf="@id/fabSaveJournalEntry">

        <View android:id="@+id/dotYellow" android:layout_width="24dp" android:layout_height="24dp" android:layout_margin="6dp" android:background="@drawable/circle_badge" android:backgroundTint="#FDF0CD" />
        <View android:id="@+id/dotBlue" android:layout_width="24dp" android:layout_height="24dp" android:layout_margin="6dp" android:background="@drawable/circle_badge" android:backgroundTint="#3D405B" />
        <View android:id="@+id/dotRed" android:layout_width="24dp" android:layout_height="24dp" android:layout_margin="6dp" android:background="@drawable/circle_badge" android:backgroundTint="#E63946" />
        <View android:id="@+id/dotGreen" android:layout_width="24dp" android:layout_height="24dp" android:layout_margin="6dp" android:background="@drawable/circle_badge" android:backgroundTint="#81B29A" />
        <View android:id="@+id/dotPurple" android:layout_width="24dp" android:layout_height="24dp" android:layout_margin="6dp" android:background="@drawable/circle_badge" android:backgroundTint="#A06CD5" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSaveJournalEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/checkbox_on_background"
        android:backgroundTint="@color/accent_brown"
        app:tint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnJournalEditorBack"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Save Entry" />

    <EditText
        android:id="@+id/etJournalEntryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Title..."
        android:textColorHint="@color/text_hint_darker"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_card"
        android:padding="12dp"
        android:inputType="textCapWords"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/btnJournalEditorBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etJournalEntryBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:hint="Type your thoughts here..."
        android:textColorHint="@color/text_hint_darker"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:gravity="top|start"
        android:background="@drawable/bg_rounded_card"
        android:padding="16dp"
        android:inputType="textMultiLine|textCapSentences"
        android:importantForAutofill="no"
        app:layout_constraintTop_toBottomOf="@id/etJournalEntryTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>