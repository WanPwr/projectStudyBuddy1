<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#DDBB99">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Check in"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#000000"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/tvCheckInSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back to your daily check\nin streak!"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:elevation="4dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="55sp"
                android:layout_gravity="center" />
        </FrameLayout>

        <Button
            android:id="@+id/btnCheckInConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Lets go!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00CC44"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>